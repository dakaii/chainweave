# ChainWeave Environment Configuration

# Google Cloud Configuration
PROJECT_ID=chainweave-analytics
DATASET_ID=chainweave
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# Helius API Configuration
HELIUS_API_KEY=your-helius-api-key-here

# Webhook Configuration
WEBHOOK_SECRET=your-webhook-secret-here

# Redis Configuration (optional, uses in-memory fallback if not provided)
REDIS_URL=redis://localhost:6379

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RATE_LIMIT=1000

# Dashboard Configuration
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8501
DASHBOARD_AUTO_REFRESH=true

# Database Configuration
DB_BATCH_SIZE=1000
DB_TIMEOUT_SECONDS=300

# Cache Configuration
CACHE_TTL_MINUTES=15
CACHE_MAX_MEMORY_ITEMS=1000

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security Configuration
CORS_ORIGINS=*
API_KEY_HEADER=X-API-Key

# Feature Flags
ENABLE_WHALE_DETECTION=true
ENABLE_RARITY_CALCULATION=true
ENABLE_REAL_TIME_STREAMING=true

# Processing Configuration
WHALE_THRESHOLD_SOL=50.0
WHALE_ALERT_COOLDOWN_HOURS=6
RARITY_UPDATE_INTERVAL_HOURS=24

# Monitoring Configuration
HEALTH_CHECK_INTERVAL_SECONDS=30
METRICS_EXPORT_INTERVAL_SECONDS=60