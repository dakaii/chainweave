# ChainWeave Data Processor Dockerfile
FROM python:3.11-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/backend/src

# Set work directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    cron \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY backend/requirements.txt /app/backend/
RUN pip install --no-cache-dir -r backend/requirements.txt

# Copy application code
COPY backend/ /app/backend/

# Create non-root user
RUN useradd -m -u 1000 chainweave && chown -R chainweave:chainweave /app
USER chainweave

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD python -c "import sys; sys.path.append('/app/backend/src'); from services.data_processor import create_data_processor; print('OK')" || exit 1

# Run the data processor
CMD ["python", "-c", "import sys; sys.path.append('/app/backend/src'); from services.data_processor import create_data_processor; import asyncio; import os; processor = create_data_processor(os.environ['PROJECT_ID'], os.environ['DATASET_ID'], os.environ.get('REDIS_URL')); asyncio.run(processor.start())"]